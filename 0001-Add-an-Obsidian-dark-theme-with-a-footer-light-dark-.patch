+  --bg: #000000;
+  --text: #ffffff;
+  --ink-2: #cbcbcb;
+  --ink-3: #a7a7a7;
+  --ink-4: #8a8a8a;
+  --line: #2a2828;
+  --accent: #6289ff;
+  --accent-hover: #7b9cff;
+  --accent-bright: #6289ff;
+  --accent-deep: #6289ff;
+  --paper-ink: #ffffff;
+  --font-text: "Work Sans", "Helvetica Neue", Arial, sans-serif;
+  --font-display: "Work Sans", "Helvetica Neue", Arial, sans-serif;
+  --surface: #0f0f0f;
+  --surface-shadow: none;
+  --r-card: 15px;
+  --r-mini: 12px;
+  --r-strip: 15px;
+  --r-sheet: 23px;
+  --shadow-lift: 0 22px 44px -26px rgba(98, 137, 255, 0.45);
+  --glass-spec: inset 0 1px 0 rgba(255, 255, 255, 0.06);
+  --glass-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
+  --edge: linear-gradient(15deg, rgba(50, 50, 50, 0.5) 35%, rgba(255, 255, 255, 0.25) 80%);
+  --chip-grad: linear-gradient(224deg, #6c8ae3 -47.2%, #3d60c9 74.45%);
+}
