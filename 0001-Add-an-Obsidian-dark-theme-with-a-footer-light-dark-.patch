+/* ── Theme switch (footer) ───────────────────────────────────────────── */
+.theme-switch {
+  display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 0;
+  border: 0; background: none; color: var(--ink-3); font-size: 13px;
+}
+.theme-switch:hover { color: var(--text); }
+.theme-switch__track {
+  position: relative; display: inline-flex; align-items: center; justify-content: space-between;
+  width: 64px; height: 32px; padding: 0 9px; border-radius: 999px;
+  border: 1px solid var(--line); background: color-mix(in srgb, var(--text) 6%, transparent);
+  transition: background 0.3s ease, border-color 0.3s ease;
+}
+.theme-switch__track svg {
+  position: relative; z-index: 1; width: 14px; height: 14px;
+  fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
+  transition: color 0.3s ease, opacity 0.3s ease;
+}
+.theme-switch__thumb {
+  position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 999px;
+  background: #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
+  transition: transform 0.35s var(--ease-snap), background 0.3s ease;
+}
+.theme-switch__sun { color: var(--text); }
+.theme-switch__moon { color: var(--ink-4); }
+.theme-switch[aria-checked="true"] .theme-switch__thumb {
+  transform: translateX(32px);
+  background: linear-gradient(224deg, #6c8ae3 -47.2%, #3d60c9 74.45%); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
+}
+.theme-switch[aria-checked="true"] .theme-switch__sun { color: var(--ink-4); }
+.theme-switch[aria-checked="true"] .theme-switch__moon { color: #fff; }
+/* without scripting the switch has nothing to do */
+html:not(.js) .theme-switch { display: none; }
+/* a short cross-fade when the visitor flips the theme */
+.theme-swap, .theme-swap *, .theme-swap *::before, .theme-swap *::after {
+  transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease !important;
+}
+
+/* ── Dark theme: "Obsidian" ──────────────────────────────────────────────
+   Black stage, lit product, one blue signal. Work Sans at 500 for headings,
+   hairline glass chrome, cards with a gradient edge instead of shadows,
+   squarer corners, the blue eyebrow flanked by diamond-ended rules. */
